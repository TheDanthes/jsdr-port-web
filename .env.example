# ---- Base de datos (copia local de producción) ----
POSTGRES_PASSWORD=jsdr_dev
DATABASE_URL=postgresql://jsdr:jsdr_dev@127.0.0.1:55432/jsdr_copia

# En ZimaOS la API corre en un contenedor: el host es `db`, no 127.0.0.1
# DATABASE_URL=postgresql://jsdr:jsdr_dev@db:5432/jsdr_copia

# ---- Salida a InDesign ----
# Desarrollo: carpeta local. Producción: /u/indesign (NFS desde 192.168.1.5)
JSDR_SALIDA_INDESIGN=./salida-indesign
# ZimaOS: /salida-indesign  (montado desde /DATA/AppData/jsdr/salida-indesign)

# ---- Motor tipográfico ----
# Rutas que esperan los binarios medir y sr2xp (variables SDR_*)
SDR_ROOT=/opt/jsdr
SDR_FONTS=/opt/jsdr/fonts/
SDR_UFRM=/opt/jsdr/formatos/
SDR_ESTIL_PPAL=/opt/jsdr/estilos/
SDR_EXCEP_PPAL=/opt/jsdr/excepciones/
SDR_TMP=/tmp/

# ---- API ----
API_PORT=3000
# ZimaOS: 3099
